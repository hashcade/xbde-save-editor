<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="XbdeEditor.Gui.AboutWindow" Title="{DynamicResource About}" Width="440"
        SizeToContent="Height" CanResize="False" WindowStartupLocation="CenterOwner">
  <StackPanel Margin="24" Spacing="16">
    <TextBlock Text="XBDE Save Editor" FontWeight="SemiBold" />
    <StackPanel Orientation="Horizontal" Spacing="8">
      <TextBlock Text="{DynamicResource Version}" />
      <TextBlock Name="VersionValue" />
    </StackPanel>
    <Button Content="github.com/jinghaihan/xbde-save-editor" HorizontalAlignment="Left" Click="OpenProject_Click" />
  </StackPanel>
</Window>
