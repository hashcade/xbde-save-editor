<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>XbdeEditor.Gui</AssemblyName>
    <RootNamespace>XbdeEditor.Gui</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <PublishTrimmed Condition="'$(Configuration)' == 'Release'">true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <ILLinkTreatWarningsAsErrors>false</ILLinkTreatWarningsAsErrors>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <PackageReference Include="SukiUI" Version="7.0.1" />
    <ProjectReference Include="../core/Core.csproj" />
    <EmbeddedResource Include="Localization/*.json" WithCulture="false" />
  </ItemGroup>
  <ItemGroup Condition="'$(PublishTrimmed)' == 'true'">
    <ProjectReference Include="../cli/Cli.csproj" />
    <TrimmerRootAssembly Include="XbdeEditor.Gui" />
    <TrimmerRootAssembly Include="XbdeEditor.Core" />
    <TrimmerRootAssembly Include="XbdeEditor.Cli" />
  </ItemGroup>
</Project>
